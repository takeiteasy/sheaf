;;;; emit.lisp

(in-package #:sheaf/tests)

(in-suite sheaf)

(defun build-c (assigned binary &rest options)
  "Compile ASSIGNED's C file to BINARY, signalling an error with the compiler's
output if it fails."
  (uiop:with-temporary-file (:pathname source :type "c")
    (sheaf:write-c assigned source)
    (multiple-value-bind (output errors code)
        (uiop:run-program
         (append (list (or (uiop:getenv "CC") "cc") "-std=c11" "-Wall" "-Wextra" "-Werror"
                       "-I" (namestring (asdf:system-relative-pathname "sheaf" "runtime/")))
                 options
                 (list "-o" (namestring binary) (namestring source)))
         :output :string :error-output :string :ignore-error-status t)
      (declare (ignore output))
      (unless (zerop code)
        (error "The C compiler failed:~%~a" errors)))))

(defun run-c (assigned &rest options)
  "Compile and run ASSIGNED's C file. Returns its standard output, standard error
and exit code."
  (uiop:with-temporary-file (:pathname binary :type "bin")
    (apply #'build-c assigned binary options)
    (uiop:run-program (list (namestring binary))
                      :output :string :error-output :string :ignore-error-status t)))

(defun c-result (fixture)
  (parse-integer (run-c (assigned fixture))))

(test compiled-programs-match-the-interpreter
  (is (= 51 (c-result "closures")))
  (is (= 55 (c-result "flows")))
  (is (= 21 (c-result "recursive-data")))
  (is (= 47 (c-result "stacks"))))

(test accepted-references-match-the-interpreter-in-c
  (is (= 163 (c-result "roots"))))

(test a-self-tail-call-is-a-loop
  (is (= 10500500 (c-result "tail"))))

(test tail-calls-between-functions-are-loops
  (is (= 6000001 (c-result "mutual-tail"))))

(test functions-that-tail-call-each-other-are-one-function
  (let ((program (sheaf:c-program (assigned "mutual-tail"))))
    (is (= 5 (length (nodes-of program :label))))))

(test an-exit-out-of-a-loop-gives-back-what-the-iteration-built
  (is (= 19986 (c-result "loop-exits")))
  (multiple-value-bind (output errors code) (run-c (assigned "loop-exits") "-DSHEAF_STACK_SIZE=4096")
    (is (zerop code) "~a" errors)
    (is (= 19986 (parse-integer output)))))

(test a-loop-gives-back-the-cells-its-iteration-built
  (is (= 200001 (c-result "loop-reuse")))
  (multiple-value-bind (output errors code) (run-c (assigned "loop-reuse") "-DSHEAF_STACK_SIZE=4096")
    (is (zerop code) "~a" errors)
    (is (= 200001 (parse-integer output)))))

(test an-exhausted-data-stack-aborts
  (multiple-value-bind (output errors code) (run-c (assigned "tail") "-DSHEAF_STACK_SIZE=4096")
    (declare (ignore output))
    (is (/= 0 code))
    (is (search "exhausted" errors))))

(defun nodes-of (tree kind)
  "Every node of KIND in the C TREE."
  (cond ((atom tree) '())
        ((eq (first tree) kind)
         (cons tree (loop :for child :in (rest tree) :append (nodes-of child kind))))
        (t (loop :for child :in tree :append (nodes-of child kind)))))

(test a-program-is-a-list-of-nodes-ending-in-main
  (let* ((program (sheaf:c-program (assigned "tail")))
         (main (car (last program))))
    (is (equal '(:comment "Generated by Sheaf.") (first program)))
    (is (equal '(:include "sheaf.h") (second program)))
    (is (eq :fn (first main)))
    (is (equal "main" (third main)))))

(test a-self-tail-call-is-a-goto-node
  (is (nodes-of (sheaf:c-program (assigned "tail")) :goto))
  (is (null (nodes-of (sheaf:c-program (assigned "arrays")) :goto))))

(test every-prelude-operation-has-one-emitter
  (dolist (entry sheaf::*prelude-ops*)
    (is (gethash (first entry) sheaf::*prelude-emitters*) "~s has no emitter" (first entry)))
  (maphash (lambda (op emitter)
             (declare (ignore emitter))
             (is (assoc op sheaf::*prelude-ops*) "~s is not an operation" op))
           sheaf::*prelude-emitters*))

(test raw-lisp-is-not-emitted
  (signals error (sheaf:emit-c (assigned "counter"))))

(defun c-result-from (fixture root)
  "The result of the C program for the function ROOT of FIXTURE, and the interpreter's."
  (let ((assigned (sheaf:assign-stacks (lowered-from fixture root))))
    (values (parse-integer (run-c assigned)) (sheaf:run-lowered assigned))))

(test prelude-programs-match-the-interpreter-in-c
  (is (= 116 (c-result "arrays")))
  (is (= 29 (c-result "cells")))
  (is (= 19 (c-result "stdlib")))
  (is (= 5 (c-result "voids")))
  (is (= 224 (c-result "returns")))
  (is (= 500 (c-result "for-loops")))
  (is (= 53 (c-result "vectors")))
  (is (= (run-on-sbcl "vector-library") (c-result "vector-library")))
  (is (= (run-on-sbcl "lists") (c-result "lists")))
  (is (= (run-on-sbcl "extend") (c-result "extend")))
  (is (= (run-on-sbcl "table-iterators") (c-result "table-iterators")))
  (is (= (run-on-sbcl "vector-folds") (c-result "vector-folds")))
  (is (= (run-on-sbcl "poly") (c-result "poly"))))

(test growables-match-the-interpreter-in-c
  (dolist (root '("MAIN-TWO" "MAIN-LIST" "MAIN-RELAY" "MAIN-EITHER" "MAIN-LISTED" "MAIN-DOWN"
                  "MAIN-PICKED" "MAIN-CELL" "MAIN-TABLE" "MAIN-VECTORS" "MAIN-TWOS" "MAIN-DEEP"
                  "MAIN-REUSE"))
    (multiple-value-bind (compiled interpreted) (c-result-from "growables" root)
      (is (= interpreted compiled) "~a" root))))

(test an-index-outside-an-array-aborts-in-c
  (multiple-value-bind (output errors code) (run-c (assigned "out-of-bounds"))
    (declare (ignore output))
    (is (/= 0 code))
    (is (search "outside" errors))))

(test a-growable-under-another-value-aborts-in-c
  (multiple-value-bind (output errors code) (run-c (with-shared-stack "arrays" "TWO-ARRAYS"))
    (declare (ignore output))
    (is (/= 0 code))
    (is (search "grew under" errors))))

(test hash-tables-match-the-interpreter-in-c
  (is (= (sheaf:run-lowered (assigned "hashtables")) (c-result "hashtables")))
  (dolist (root '("MAIN-MANY" "MAIN-TABLES"))
    (multiple-value-bind (compiled interpreted) (c-result-from "hashtables" root)
      (is (= interpreted compiled) "~a" root))))

(test a-hash-table-count-and-a-computed-capacity-match-the-interpreter-in-c
  (dolist (root '("COUNTED" "MAIN-SIZED"))
    (multiple-value-bind (compiled interpreted) (c-result-from "hashtables" root)
      (is (= interpreted compiled) "~a" root))))

(defparameter *small-banks* '("-DSHEAF_SLICE_SIZE=65536" "-DSHEAF_BANK_SPACE=524288")
  "Eight slices of bank space.")

(defun banked-c (root &rest options)
  (apply #'run-c (sheaf:assign-stacks (lowered-from "growables" root)) options))

(test a-bank-hands-out-slices-and-takes-them-back
  (multiple-value-bind (output errors code) (apply #'banked-c "MAIN-REUSE" *small-banks*)
    (declare (ignore errors))
    (is (zerop code))
    (is (= (sheaf:run-lowered (sheaf:assign-stacks (lowered-from "growables" "MAIN-REUSE")))
           (parse-integer output)))))

(test freed-slices-are-returned-to-the-os
  (multiple-value-bind (output errors code) (apply #'banked-c "MAIN-REUSE" "-DSHEAF_SLICE_KEEP=0" *small-banks*)
    (declare (ignore errors))
    (is (zerop code))
    (is (= (sheaf:run-lowered (sheaf:assign-stacks (lowered-from "growables" "MAIN-REUSE")))
           (parse-integer output)))))

(test a-cycle-deeper-than-the-bank-space-aborts-in-c
  (multiple-value-bind (output errors code) (apply #'banked-c "MAIN-DEEP" *small-banks*)
    (declare (ignore output))
    (is (/= 0 code))
    (is (search "bank space exhausted" errors))))

(test clones-are-named-in-comments
  (is (search "// PAIR<" (sheaf:emit-c (assigned "stacks")))))

(defun big-loops ()
  (sheaf:assign-stacks (lowered-from "loops" "BIG")))

(test a-loop-that-resets-runs-in-a-small-stack
  (is (= 15850 (c-result "loops")))
  (is (= 1500008500000
         (parse-integer (run-c (big-loops) "-DSHEAF_STACK_SIZE=4096")))))

(test a-resetting-tail-call-gives-its-stack-back-before-it-jumps
  (is (nodes-of (sheaf:c-program (big-loops)) :goto))
  (is (search "iter_mark" (with-output-to-string (out) (sheaf:emit-c (big-loops) out)))))

(test a-banked-loop-runs-in-a-small-bank
  (is (= 37 (c-result "banked-loops")))
  (loop :for (root expected) :in '(("BIG-PROBE" 200000) ("BIG-PING" 150000))
        :do (multiple-value-bind (output errors code)
                (apply #'run-c (sheaf:assign-stacks (lowered-from "banked-loops" root)) *small-banks*)
              (is (zerop code) "~a: ~a" root errors)
              (is (= expected (parse-integer output)) "~a" root))))

(defun big-alternating-loops ()
  (sheaf:assign-stacks (lowered-from "alternating-loops" "BIG")))

(test a-loop-that-alternates-runs-in-two-small-stacks
  (is (= 247 (c-result "alternating-loops")))
  (is (= 500011500016
         (parse-integer (run-c (big-alternating-loops) "-DSHEAF_STACK_SIZE=4096")))))

(test a-loop-that-alternates-gives-its-spare-region-back-before-it-jumps
  (is (search "frame_mark_" (with-output-to-string (out) (sheaf:emit-c (big-alternating-loops) out)))))

(test a-loop-that-copies-out-runs-in-two-small-stacks
  (multiple-value-bind (compiled interpreted) (c-result-from "alternating-loops" "MAIN-LISTS")
    (is (= 193 interpreted))
    (is (= interpreted compiled)))
  (is (= 500011500027
         (parse-integer (run-c (sheaf:assign-stacks (lowered-from "alternating-loops" "BIG-LISTS"))
                               "-DSHEAF_STACK_SIZE=4096")))))

(test an-early-return-of-a-growable-value-matches-in-c
  (is (= (run-on-sbcl "growable-returns")
         (parse-integer (run-c (assigned "growable-returns") "-fsanitize=address" "-g")))))
