;;;; growable-returns.lisp
;;;; Early returns of a Vector: out of a branch, with another Vector live, out
;;;; of a closure and out of a loop body that builds one on every iteration.

(defpackage #:sheaf/fixtures/growable-returns
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames
   (#:vector #:coalton/vector)))

(in-package #:sheaf/fixtures/growable-returns)

(coalton-toplevel
  (declare grown (UFix -> (Vector UFix)))
  (define (grown n)
    (let ((v (the (Vector UFix) (vector:new))))
      (vector:push! n v)
      (when (> n 5)
        (return v))
      (vector:push! n v)
      v))

  (declare branchy (UFix -> (Vector UFix)))
  (define (branchy n)
    (when (> n 5)
      (let ((a (the (Vector UFix) (vector:new))))
        (vector:push! n a)
        (return a)))
    (let ((b (the (Vector UFix) (vector:new))))
      (vector:push! 1 b)
      (vector:push! 2 b)
      b))

  (declare other (UFix -> (Vector UFix)))
  (define (other n)
    (let ((a (the (Vector UFix) (vector:new))))
      (vector:push! n a)
      (when (> n 5)
        (return a))
      (let ((b (the (Vector UFix) (vector:new))))
        (vector:push! 1 b)
        (vector:push! 2 b)
        (vector:push! 3 b)
        b)))

  (declare through-closure (UFix -> UFix))
  (define (through-closure n)
    (let ((f (fn (k)
               (let ((a (the (Vector UFix) (vector:new))))
                 (vector:push! k a)
                 (when (> k 5)
                   (return a))
                 (vector:push! k a)
                 a))))
      (let ((v (f n)))
        (vector:push! 1 v)
        (vector:length v))))

  (declare found (UFix * UFix -> (Vector UFix)))
  (define (found limit target)
    (let ((b (the (Vector UFix) (vector:new))))
      (vector:push! 100 b)
      (for ((i 0 (+ i 1)))
        :until (== i limit)
        (let ((a (the (Vector UFix) (vector:new))))
          (vector:push! i a)
          (vector:push! i a)
          (when (== i target)
            (return a))))
      (vector:push! 200 b)
      (vector:push! 300 b)
      b))

  (declare main (Void -> UFix))
  (define (main)
    (let ((x (other 9)) (y (other 2)) (z (grown 9)) (w (grown 2))
          (p (branchy 9)) (q (branchy 2))
          (r (found 5 3)) (s (found 5 9)) (u (found 100000 99999)))
      (vector:push! 7 x)
      (vector:push! 7 r)
      (let ((a (+ (vector:length x) (* 10 (vector:length y))))
            (b (+ (* 100 (vector:length z)) (* 1000 (vector:length w))))
            (c (+ (* 10000 (through-closure 9)) (through-closure 2)))
            (d (+ (vector:length p) (vector:length q)))
            (e (+ (vector:length r) (+ (vector:length s) (vector:length u)))))
        (+ a (+ b (+ c (+ d e))))))))
