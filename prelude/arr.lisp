;;;; arr.lisp

(in-package #:sheaf/prelude/arr)

(coalton-toplevel
  (declare new (UFix * :t -> prelude:Array :t))
  (define (new n x)
    (lisp (-> (prelude:Array :t)) (n x)
      (cl:make-array n :initial-element x)))

  (define-class (Indexed :f)
    (length ((:f :t) -> UFix))
    (index ((:f :t) * UFix -> :t))
    (set! ((:f :t) * UFix * :t -> Unit)))

  (define-class (Viewable :f)
    (ref ((:f :t) * UFix -> prelude:Ref :t))
    (slice ((:f :t) * UFix * UFix -> prelude:Slice :t)))

  (define-instance (Indexed (prelude:FixedArray :n))
    (define (length a) (lisp (-> UFix) (a) (cl:length a)))
    (define (index a i) (lisp (-> :t) (a i) (cl:aref a i)))
    (define (set! a i x)
      (lisp (-> Unit) (a i x)
        (cl:setf (cl:aref a i) x)
        coalton-impl/constants:+value-of-unit+)))

  (define-instance (Viewable (prelude:FixedArray :n))
    (define (ref a i)
      (lisp (-> (prelude:Ref :t)) (a i)
        (cl:assert (cl:< i (cl:length a)))
        (prelude::make-ref-internal :vector a :index i)))
    (define (slice a lo hi)
      (lisp (-> (prelude:Slice :t)) (a lo hi)
        (cl:assert (cl:<= lo hi (cl:length a)))
        (prelude::make-slice-internal :vector a :start lo :end hi))))

  (define-instance (Indexed prelude:Array)
    (define (length a) (lisp (-> UFix) (a) (cl:length a)))
    (define (index a i) (lisp (-> :t) (a i) (cl:aref a i)))
    (define (set! a i x)
      (lisp (-> Unit) (a i x)
        (cl:setf (cl:aref a i) x)
        coalton-impl/constants:+value-of-unit+)))

  (define-instance (Viewable prelude:Array)
    (define (ref a i)
      (lisp (-> (prelude:Ref :t)) (a i)
        (cl:assert (cl:< i (cl:length a)))
        (prelude::make-ref-internal :vector a :index i)))
    (define (slice a lo hi)
      (lisp (-> (prelude:Slice :t)) (a lo hi)
        (cl:assert (cl:<= lo hi (cl:length a)))
        (prelude::make-slice-internal :vector a :start lo :end hi))))

  (define-instance (Indexed prelude:GrowArray)
    (define (length a) (lisp (-> UFix) (a) (cl:length a)))
    (define (index a i) (lisp (-> :t) (a i) (cl:aref a i)))
    (define (set! a i x)
      (lisp (-> Unit) (a i x)
        (cl:setf (cl:aref a i) x)
        coalton-impl/constants:+value-of-unit+)))

  (define-instance (Viewable prelude:GrowArray)
    (define (ref a i)
      (lisp (-> (prelude:Ref :t)) (a i)
        (cl:assert (cl:< i (cl:length a)))
        (prelude::make-ref-internal :vector a :index i)))
    (define (slice a lo hi)
      (lisp (-> (prelude:Slice :t)) (a lo hi)
        (cl:assert (cl:<= lo hi (cl:length a)))
        (prelude::make-slice-internal :vector a :start lo :end hi))))

  (define-instance (Indexed prelude:Stack)
    (define (length a) (lisp (-> UFix) (a) (cl:length a)))
    (define (index a i) (lisp (-> :t) (a i) (cl:aref a i)))
    (define (set! a i x)
      (lisp (-> Unit) (a i x)
        (cl:setf (cl:aref a i) x)
        coalton-impl/constants:+value-of-unit+)))

  (define-instance (Indexed prelude:Slice)
    (define (length s)
      (lisp (-> UFix) (s)
        (cl:- (prelude::slice-internal-end s) (prelude::slice-internal-start s))))
    (define (index s i)
      (lisp (-> :t) (s i)
        (cl:assert (cl:< i (cl:- (prelude::slice-internal-end s)
                                 (prelude::slice-internal-start s))))
        (cl:aref (prelude::slice-internal-vector s) (cl:+ (prelude::slice-internal-start s) i))))
    (define (set! s i x)
      (lisp (-> Unit) (s i x)
        (cl:assert (cl:< i (cl:- (prelude::slice-internal-end s)
                                 (prelude::slice-internal-start s))))
        (cl:setf (cl:aref (prelude::slice-internal-vector s)
                          (cl:+ (prelude::slice-internal-start s) i))
                 x)
        coalton-impl/constants:+value-of-unit+)))

  (define-instance (Viewable prelude:Slice)
    (define (ref s i)
      (lisp (-> (prelude:Ref :t)) (s i)
        (cl:assert (cl:< i (cl:- (prelude::slice-internal-end s)
                                 (prelude::slice-internal-start s))))
        (prelude::make-ref-internal :vector (prelude::slice-internal-vector s)
                                    :index (cl:+ (prelude::slice-internal-start s) i))))
    (define (slice s lo hi)
      (lisp (-> (prelude:Slice :t)) (s lo hi)
        (cl:assert (cl:<= lo hi (cl:- (prelude::slice-internal-end s)
                                      (prelude::slice-internal-start s))))
        (prelude::make-slice-internal :vector (prelude::slice-internal-vector s)
                                      :start (cl:+ (prelude::slice-internal-start s) lo)
                                      :end (cl:+ (prelude::slice-internal-start s) hi))))))
